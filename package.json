{
  "name": "argon-dashboard-angular",
  "version": "3.248.3",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/install-backend-deps.js",
    "install:all": "node scripts/install-all.js",
    "prestart": "node scripts/setup-dev-env.js --quiet",
    "start": "node ./node_modules/concurrently/dist/bin/concurrently.js \"node backend/server.js\" \"node scripts/ng-serve-dev.js\"",
    "start:all": "node scripts/setup-dev-env.js --quiet && node ./node_modules/concurrently/dist/bin/concurrently.js \"node backend/server.js\" \"node scripts/ng-serve-dev.js\" \"npm run open:browser\"",
    "start:frontend": "node scripts/ng-serve-dev.js",
    "start:backend": "node scripts/setup-dev-env.js --quiet && node backend/server.js",
    "setup:dev": "node scripts/setup-dev-env.js",
    "db:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/abrir-mariadb-lan.ps1",
    "open:browser": "wait-on -t 420000 http-get://localhost:4200/main.js && powershell -NoProfile -Command Start-Process 'http://localhost:4200/'",
    "open:chrome": "npm run open:browser",
    "start:chrome": "node scripts/setup-dev-env.js --quiet && node ./node_modules/concurrently/dist/bin/concurrently.js \"node backend/server.js\" \"node scripts/ng-serve-dev.js\" && start chrome http://localhost:4200",
    "build": "cross-env CI=false ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "install:clean": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true}); require('fs').rmSync('backend/node_modules',{recursive:true,force:true});\" && npm run install:all && npm start",
    "security:audit": "node scripts/security-audit.js --format both --out-dir reports/security-audit",
    "security:audit:quick": "node scripts/security-audit.js --skip-deps --fail-on none --format both --out-dir reports/security-audit",
    "check:email": "cd backend && node verify-email-service.js"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^1.0.0",
    "@angular/animations": "^14.2.0",
    "@angular/cdk": "^14.2.0",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/google-maps": "^14.2.0",
    "@angular/localize": "^14.2.0",
    "@angular/material": "^14.2.0",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "@ng-bootstrap/ng-bootstrap": "^13.1.1",
    "@popperjs/core": "^2.11.4",
    "apexcharts": "^3.36.3",
    "bootstrap": "4.6.1",
    "chart.js": "2.9.4",
    "clipboard": "2.0.10",
    "dompurify": "^3.4.2",
    "dotenv": "^17.2.3",
    "echarts": "^5.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "ng-apexcharts": "1.7.6",
    "ngx-clipboard": "15.0.1",
    "ngx-echarts": "^14.0.0",
    "ngx-toastr": "14.2.2",
    "nodemailer": "^8.0.1",
    "nouislider": "15.5.1",
    "pdfjs-dist": "^3.11.174",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.5.0",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.17",
    "web-animations-js": "2.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^14.1.0",
    "@angular-devkit/build-angular": "^14.2.7",
    "@angular/cli": "~14.2.7",
    "@angular/compiler-cli": "^14.2.0",
    "@angular/language-service": "14.2.0",
    "@types/chart.js": "^2.9.41",
    "@types/jasmine": "~4.0.0",
    "@types/jasminewd2": "~2.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^17.0.21",
    "@types/qrcode": "^1.5.6",
    "codelyzer": "6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jasmine-core": "~4.4.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ts-node": "~10.9.1",
    "typescript": "~4.7.2",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "protractor": "npm:empty-npm-package@^1.0.0"
  }
}
