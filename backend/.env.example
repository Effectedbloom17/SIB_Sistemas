# Google Form — Registro de inscripción CBT José Antonio Alzate
CBT_INSCRIPCION_FORM_ID=1y3yDwuDp839XBJd40aTdaMziYJJiLugjjKPTcYd4WMY

# --- Protección Civil: SP-F-29 Control de resolutivos PIPC (Google Sheets) ---
PC_SPF29_SHEET_ID=1av1MXA-tBjVnWpHmufB55jxUiTrF06ZO
PC_SPF29_SHEET_NAME=Hoja1
PC_SPF29_DESIGN_SHEET_NAME=Diseños
PC_SPF29_DATA_START_ROW=7
PC_SPF29_DRIVE_FOLDER_ID=1Z2Ba-6dUN3mLcAwBhgGkaA8-1uaQxTJJ

# --- Google Slides (plantilla para constancias) ---
GOOGLE_SLIDES_TEMPLATE_ID=id_del_documento_slides

# --- Google Forms (plantilla para encuestas de satisfaccion) ---
GOOGLE_FORMS_TEMPLATE_ID=id_del_formulario_forms

# --- SGC-F-26 · Encuesta de satisfacción del cliente (Dashboard SGC) ---
# Formulario fijo de Google Forms; el dashboard lee respuestas en vivo.
SGC_SATISFACCION_CLIENTE_FORM_ID=1otY7kAA7Ko5CICg2-HwpdLjVEU5hsj6onUM-0NC5tDs

# --- Email (SMTP dedicado para envio) ---
# Producción SSL: mail.tu-dominio.com:465 con SMTP_SECURE=true
# Producción STARTTLS: mail.tu-dominio.com:587 con SMTP_SECURE=false y SMTP_REQUIRE_TLS=true
# Brevo SMTP: smtp-relay.brevo.com:587, SMTP_USER=usuario@smtp-brevo.com
# Desarrollo: puede quedar sin acceso, usa SMTP_VERIFY_TIMEOUT bajo para fallar rápido
SMTP_HOST=mail.tu-dominio.com
SMTP_PORT=587
SMTP_USER=cuenta_sistema@tu-dominio.com
SMTP_PASS=tu_password_smtp
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_AUTO_VERIFY=false
SMTP_VERIFY_TIMEOUT=15000
SMTP_QUEUE_ENABLED=true
SMTP_QUEUE_DELAY_MS=1000
SMTP_POOL_ENABLED=true
SMTP_MAX_CONNECTIONS=1
SMTP_MAX_MESSAGES=100
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_421_DELAY_MS=60000
EMAIL_FROM_NAME=Biznaga Risk&Tech
EMAIL_FROM_ADDRESS=sistema@biznaga.com.mx
# EMAIL_DEBUG_BCC=debug@email.com  # Opcional: recibe copia de todos los emails
# El modulo de correo no impone limite de adjuntos en la app (BODY_PAYLOAD_LIMIT=512mb).
# cPanel suele rechazar correos >20 MB; con true el envio sale por Brevo (~40 MB).
CORREO_ENVIO_VIA_BREVO=true
# Si el MIME estimado de adjuntos supera este tope (MB), se guardan en el servidor
# y el correo lleva un centro de descarga Biznaga (sin Google Drive).
CORREO_LIMITE_MENSAJE_MB=15
# Días de vigencia del enlace de descarga (default 30).
CORREO_ADJUNTOS_TTL_DIAS=30
# Rate limit de descargas públicas: máx. solicitudes por IP / ventana.
CORREO_DESCARGAS_RATE_MAX=20
CORREO_DESCARGAS_RATE_WINDOW_MS=60000
# URL pública del API (Express) usada en enlaces de descarga de correo.
# IMPORTANTE: debe ser el host del API, NO el frontend Angular.
#   Correcto:   https://api.sistema.biznaga.com.mx
#   Incorrecto: https://sistema.biznaga.com.mx  (el SPA reescribe a dashboard)
# Local: http://localhost:3100
PUBLIC_API_URL=https://api.sistema.biznaga.com.mx
# Con Brevo se puede adjuntar más (MB MIME estimados) antes de usar enlace:
# CORREO_LIMITE_MENSAJE_MB_BREVO=28
# Firmas digitales por buzón (ID de archivo JPG/PNG en Google Drive):
# Si no se define la variable, se usa el mapa por defecto en correoFirmaService.js
# CORREO_FIRMA_ALEXIS_DESIGN_BIZNAGA_COM_MX=1TSy0r1IT3NPXRfrtMGi42pFArh80FmQh
# CORREO_FIRMA_ARELI_SEGURIDAD_BIZNAGA_COM_MX=1yIQUVr4qy3WKW-36qZV_xY9TKYB7lotN
# CORREO_FIRMA_DANIEL_SEGURIDAD_BIZNAGA_COM_MX=1wWaTF8RRNlK6P5M5PxYx9QJSyjzRU2_Y
# CORREO_FIRMA_EDMUNDO_PC_BIZNAGA_COM_MX=1aX6ISt6iPTB7epyJXPOJEGdAFXlXb_8m
# CORREO_FIRMA_EFRAIN_SALUD_BIZNAGA_COM_MX=1UjbqyndCDEMSE5zqXSU1h5XQ_NoMB6XC
# CORREO_FIRMA_FACTURAS_BIZNAGA_COM_MX=1NfgbNF5x70GeqiaVoOWcooI539n9Xtzl
