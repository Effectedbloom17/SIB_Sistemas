# =====================================================
# BIZNAGA R&T - Variables de entorno
# =====================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales (nunca commitees .env)
#   3. Para generar JWT_SECRET:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================

# --- Entorno ---
# Valores: development | production
NODE_ENV=development

# --- Servidor HTTP ---
# Desarrollo local (default 3000). En Windows, Hyper-V/WSL suele reservar 2929-3028
# y el puerto 3000 falla con EACCES; usa 3100 u otro puerto libre.
PORT=3100

# --- LÃ­mites de subida ---
# TamaÃ±o mÃ¡ximo (MB) para documentos de ProtecciÃ³n Civil (default 50)
MAX_PC_UPLOAD_MB=50

# --- Base de datos principal ---
# Orden de conexion (el backend prueba en este orden):
#   1) DB_HOST_LOCAL  — Docker en ESTA PC (127.0.0.1)
#   2) DB_HOST_LAN    — contenedor en otra PC de la misma WiFi/LAN
#   3) DB_HOST_REMOTE — produccion (solo si DB_ALLOW_REMOTE_FALLBACK=true)
# En la PC que corre `docker compose`: deja LOCAL=127.0.0.1
# En las demas PCs: pon en DB_HOST_LAN la IP de esa PC (ej. 192.168.1.174)
# TÃºnel SSH a producciÃ³n: DB_PORT=3307 (ver INFRAESTRUCTURA-PRODUCCION.md)
DB_HOST_LOCAL=127.0.0.1
DB_HOST_LAN=192.168.1.174
DB_HOST_REMOTE=132.148.181.6
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=biznaga

# --- Bases de datos secundarias ---
DB_NAME_MEDICOS=medicos_biznaga
DB_NAME_PC=proteccion_civil
DB_NAME_SGC=biznaga_sgc
DB_NAME_NORMATIVAS=normativas
