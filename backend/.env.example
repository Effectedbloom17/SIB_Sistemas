# --- Email (IMAP para lectura de buzones por perfil en cPanel) ---
# El envío por perfil con CORREO_ENVIO_VIA_BREVO=true usa SMTP_HOST (Brevo), no cPanel.
IMAP_HOST=mail.tu-dominio.com
IMAP_PORT=993
IMAP_SECURE=true
# Password general opcional para todos los buzones:
# IMAP_PASS=tu_password_imap
# Password por buzon (recomendado si cada cuenta tiene clave distinta):
# IMAP_PASSWORD_USUARIO_TU_DOMINIO_COM=tu_password_del_buzon
# IMAP_PASSWORD_HECTOR_TI_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_ADRIAN_SEGURIDAD_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_FERNANDA_TALENTOHUMANO_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_FERNANDA_TH_BIZNAGA_COM_MX=clave_legacy_si_aplica
# IMAP_PASSWORD_JOANA_TALENTOHUMANO_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_FERNANDO_DESIGN_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_KEYLA_DESIGN_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_MARDELACRUZ058_BIZNAGA_COM_MX=clave_del_buzon
# IMAP_PASSWORD_MARIANA_ADMINISTRACION_BIZNAGA_COM_MX=clave_del_buzon
#
# IMPORTANTE produccion: copiar las mismas variables IMAP_* a backend/.env.produccion
# (deploy.ps1 sube ese archivo como .env en AWS Lightsail).
#
# Buzón compartido de empresa (modulo Correo empresa, solo administradores):
# CORREO_EMPRESA_CUENTA=contacto@biznaga.com.mx
# CORREO_EMPRESA_NOMBRE=Biznaga Risk&Tech
# IMAP_PASSWORD_CONTACTO_BIZNAGA_COM_MX=clave_del_buzon_contacto
#
# Con CORREO_ENVIO_VIA_BREVO=true las IMAP_PASSWORD_* solo se usan para leer el buzón,
# no para enviar (el envío sale por Brevo con reply-to al correo del perfil).
# Adjuntos de invitación (Google Drive): compartir los archivos con la cuenta OAuth
# configurada en GOOGLE_REFRESH_TOKEN o usar IDs de archivos accesibles por esa cuenta.

# ID opcional del workbook consolidado "Archivos PIPC" en Drive.
# Si está vacío, el sync usa los Google Sheets individuales en la carpeta PIPC
# (ej. PIPC Pachuca, PIPC Tizayuca).
# PIPC_CATALOGO_MAESTRO_DRIVE_ID=

# Carpeta Drive de categoría PIPC del catálogo (formatos individuales)
# PC_CATALOGO_PIPC_FOLDER_ID=1aQkjoiof3SzAY8D6za4FVmByyisIrrL1

# Plantilla base para crear nuevos formatos PIPC (placeholder {{nombre_formato}})
# PIPC_FORMATO_PLANTILLA_DRIVE_ID=1m_3kZo5qS4-IDp1xbJZJ72l7NeQZ4EXOMMv_g4PLXRM

# Ambiental SP-F-28: carpeta raíz "Ambiental" (Empresa / Oficio / documento + contestación)
# AMBIENTAL_SPF28_ANEXOS_FOLDER_ID=1NhqJo27LtnSmVMUoBqmUNwUFB0nYsARE

# --- Blynk IoT (módulo Sensores) ---
# Token del dispositivo en Blynk Console → Device → Device Info → Auth Token
# NUNCA commitear el token real. En producción añadir las mismas variables a .env.produccion.
# Dispositivo actual: "sensor de agua biznaga" (no el dispositivo inactivo homónimo).
BLYNK_AUTH_TOKEN=
BLYNK_SERVER=https://blynk.cloud
# Datastreams del dashboard Blynk: Volume (v0) y Altura/Range (v1)
BLYNK_VOLUME_PIN=v0
BLYNK_ALTURA_PIN=v1
BLYNK_RANGE_PIN=v1
BLYNK_DEVICE_NAME=sensor de agua biznaga
# Timeout de peticiones a Blynk en ms (default 8000)
# BLYNK_TIMEOUT_MS=8000
# Historial en BD sensores (default 30 min)
# SENSOR_HISTORIAL_MS=1800000
