# =====================================================
# BIZNAGA R&T — Variables de entorno
# =====================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales (nunca commitees .env)
#   3. Para generar JWT_SECRET:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================

# --- Entorno ---
# Valores: development | production
NODE_ENV=development

# --- Servidor HTTP ---
# Desarrollo local (default 3000). En Windows, Hyper-V/WSL suele reservar 2929-3028
# y el puerto 3000 falla con EACCES; usa 3100 u otro puerto libre.
PORT=3100

# --- Límites de subida ---
# Tamaño máximo (MB) para documentos de Protección Civil (default 50)
MAX_PC_UPLOAD_MB=50

# --- Base de datos principal ---
# Desarrollo Docker local: docker compose up -d  →  root/root en puerto 3306
# Túnel SSH a producción: DB_PORT=3307 (ver INFRAESTRUCTURA-PRODUCCION.md)
# Produccion AWS: MariaDB remota en GoDaddy (puerto 3306)
DB_HOST_LOCAL=127.0.0.1
DB_HOST_REMOTE=132.148.181.6
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=biznaga

# --- Bases de datos secundarias ---
DB_NAME_MEDICOS=medicos_biznaga
DB_NAME_PC=proteccion_civil
DB_NAME_SGC=biznaga_sgc
DB_NAME_NORMATIVAS=normativas
# Producción GoDaddy (obligatorio en .env.produccion):
# DB_NAME_NORMATIVAS=ou9c93ce6l5d_normativas
DB_NAME_SENSORES=sensores

# --- JWT ---
# OBLIGATORIO: genera un valor aleatorio con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_VALOR_ALEATORIO_LARGO

# --- Tailscale (legacy, no usar en arquitectura actual) ---
TAILSCALE_IP=

# --- CORS (origenes permitidos, separados por coma) ---
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
# Produccion AWS + frontend GoDaddy:
# CORS_ORIGINS=http://sistema.biznaga.com.mx,https://sistema.biznaga.com.mx

# --- Google Drive OAuth2 ---
# Configura en: https://console.cloud.google.com
# Genera refresh token con: node backend/setup-google-oauth.js
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxx
GOOGLE_DRIVE_FOLDER_ID=id_carpeta_raiz_en_drive
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# --- Tickets: evidencias (imagenes) en Drive ---
# Carpeta: Sistema_Integral / Tickets
TICKETS_EVIDENCIAS_DRIVE_FOLDER_ID=1N5NvC8YnRv5dF5CN_s4h07gcbxVK2xd2

# Mantenimiento EIN-F-02 / EIN-F-04
MANTENIMIENTO_DRIVE_FOLDER_ID=1PSzlU-LIr4wkCZANDgDIchY6lASsPue8
EIN_F02_TEMPLATE_ID=1AjnG4iBXqp1_rvox9c7on-yuKDUTEXtxp6uhsg1O2TY
# Documento vivo EIN-F-01 (se escribe directamente, sin copiar a EIN-F-01-AAAA)
EIN_F01_TEMPLATE_ID=1MaXJjsd9IcjiNd70Z4zXmzouEP0pZG_k9l6izOkGSng
EIN_F03_TEMPLATE_ID=1CmYDinQTOv_nuDUTa0AmiWwgN-pWJWgypQifVOU0oi0
EIN_F04_TEMPLATE_ID=1v7p3hSL-PhDYh7DsCM0vSprGTIiVcXAo
EIN_F02_FORM_ID=1JQQuYAhTah0pZkHyvM40dp1bi1s51aEXSn5rXw6zZ9Q
EIN_F04_FIRMADOS_FOLDER_ID=1q3COOqQEqbkZRPvHNz0l3mNZWn1TfXtx
# Word EIN-F-04 guardado en Historial · Formatos Físicos (subcarpeta por folio)
EIN_F04_REPORTES_FOLDER_ID=1q3COOqQEqbkZRPvHNz0l3mNZWn1TfXtx
